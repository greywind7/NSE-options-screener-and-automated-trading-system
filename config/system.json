{
  "system": {
    "name": "Upstox Algorithmic Trading Infrastructure Spec 2.0",
    "version": "2.0.0",
    "manifest": {
      "max_stream_underlyings_with_options": 221,
      "popular_strikes": 3
    },
    "feed": {
      "max_stream_underlyings_with_options": 221,
      "max_websocket_keys": 1800
    },
    "ipc": {
      "transport": "zeromq",
      "feed_ipc": "ipc:///tmp/feed_equity.ipc",
      "feed_equity_ipc": "ipc:///tmp/feed_equity.ipc",
      "feed_options_ipc": "ipc:///tmp/feed_options.ipc",
      "quotes_router_ipc": "ipc:///tmp/quotes_router.ipc",
      "quotes_stream_ipc": "ipc:///tmp/quotes_stream.ipc",
      "heartbeat_ipc": "ipc:///tmp/quotes_heartbeat.pub",
      "scoring_alerts_ipc": "ipc:///tmp/scoring_alerts_pub.ipc",
      "rms_strike_ipc": "ipc:///tmp/rms_strike_pub.ipc",
      "authkey": "upstox_algo_shared_secret",
      "buffer_capacity": 200000,
      "heartbeat_interval_sec": 1.0
    },
    "shm": {
      "shm_name": "shm_ohlc_221",
      "universe_size": 221,
      "bars_per_day": 75,
      "bytes_per_candle": 48
    },
    "recorder": {
      "enabled": true,
      "output_dir": "recordings",
      "flush_interval_sec": 300.0,
      "batch_size": 25000,
      "format": "parquet",
      "compression": "snappy",
      "split_option_depth": true,
      "preserve_full_depth": true,
      "debug": false,
      "debug_log_path": "logs/exec_logs/recorder_ticks.log"
    },
    "logging": {
      "level": "INFO",
      "log_dir": "logs",
      "main_log": "logs/exec_logs/runner.log",
      "debug_log": "logs/exec_logs/debug.log"
    }
  }
}