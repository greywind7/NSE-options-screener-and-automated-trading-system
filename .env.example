# Upstox API v2/v3 Configuration
# 1. Live Market Data & Ingestion Token (from your standard Upstox account)
UPSTOX_ACCESS_TOKEN=your_live_market_data_token_here

# 2. Upstox Sandbox Order Execution Token (from Upstox Developer Dashboard -> Sandbox Apps)
# Used when running with --mode sandbox to place orders against https://api-sandbox.upstox.com/v3/order/place
UPSTOX_SANDBOX_ACCESS_TOKEN=your_sandbox_access_token_here

# Angel One Keys
ANGEL_ONE_TOTP_KEY=your_totp_key_here
